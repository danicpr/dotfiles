{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "kitty-direct",
        "source": "/home/dev/.config/fastfetch/logo.png", // Tu Morshu ganador
        "width": 20,
        "height": 12,
        "padding": {
            "top": 1,
            "right": 3,
            "bottom": 0,
            "left": 0
        },
        "preserveAspectRatio": true
    },
    "display": {
        "separator": " " // Quitamos el separador normal para usar los iconos
    },
    "modules": [
        {
            "type": "title",
            "keyColor": "38;5;214"
        }, // Color naranja/amarillo
        {
            "type": "custom",
            "format": "──────────────────────────────",
            "outputColor": "90"
        },
        {
            "type": "os",
            "key": "╭─󰣇",
            "keyColor": "blue"
        },
        {
            "type": "host",
            "key": "├─󰌢",
            "keyColor": "blue"
        },
        {
            "type": "kernel",
            "key": "├─󰻠",
            "keyColor": "blue"
        },
        {
            "type": "uptime",
            "key": "├─󰅐",
            "keyColor": "blue"
        },
        {
            "type": "packages",
            "key": "├─󰏖",
            "keyColor": "blue"
        },
        {
            "type": "shell",
            "key": "╰─",
            "keyColor": "blue"
        },
        "break",
        {
            "type": "wm",
            "key": "╭─",
            "keyColor": "magenta"
        },
        {
            "type": "terminal",
            "key": "├─",
            "keyColor": "magenta"
        },
        {
            "type": "cpu",
            "key": "├─󰻠",
            "keyColor": "magenta"
        },
        {
            "type": "memory",
            "key": "├─󰍛",
            "keyColor": "magenta"
        },
        {
            "type": "battery",
            "key": "╰─",
            "keyColor": "magenta"
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle",
            "paddingLeft": 2
        }
    ]
}
