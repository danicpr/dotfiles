# Compile zsh
for f in ~/.zshrc ~/.zshenv ~/.config/zsh/my-cachy-config.zsh ~/.ff_functions.zsh; do
  if [[ -f "$f" && ( ! -f "$f.zwc" || "$f" -nt "$f.zwc" ) ]]; then
    zcompile "$f" &!
  fi
done

source ~/.config/zsh/my-cachy-config.zsh
# Colores dinámicos de Caelestia
[[ -f "$HOME/.local/state/caelestia/sequences.txt" ]] && cat "$HOME/.local/state/caelestia/sequences.txt"

export LS_COLORS="di=1;36:ln=1;35:so=32:pi=33:ex=1;32:bd=34;46:cd=34;43:su=30;41:sg=30;46:tw=30;42:ow=30;43"

eval "$(zoxide init zsh --cmd cd)"

# Cargar módulo de Fastfetch GIF Manager
source ~/.ff_functions.zsh

#Aliases
alias zi='__zoxide_zi'
alias snvim='sudo -E nvim'
alias mirrors="sudo reflector --latest 10 --protocol https --sort rate --save /etc/pacman.d/mirrorlist"
alias mvn-new='mvn archetype:generate -DgroupId=com.default.app -DartifactId=my-app -DarchetypeArtifactId=maven-archetype-quickstart -DarchetypeVersion=1.5 -DinteractiveMode=false'
alias sun='sudo tailscale up && sunshine'

# omp() {
#     clear && command omp "$@"
# }

[[ -r "$HOME/.secrets/api_keys.zsh" ]] && source "$HOME/.secrets/api_keys.zsh"

export SDKMAN_DIR="$HOME/.sdkman"
[[ -s "$HOME/.sdkman/bin/sdkman-init.sh" ]] && source "$HOME/.sdkman/bin/sdkman-init.sh"

FNM_PATH="$HOME/.cargo/bin"
if [[ -x "$FNM_PATH/fnm" ]]; then
  export PATH="$FNM_PATH:$PATH"
  eval "$("$FNM_PATH/fnm" env)"
fi

