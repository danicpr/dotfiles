#!/bin/bash
set -e

PROFILES_INI="$HOME/.zen/profiles.ini"

if [ ! -f "$PROFILES_INI" ]; then
    echo "Zen aún no ha generado profiles.ini, salta este paso"
    exit 0
fi

# Extrae el path del primer perfil "Default=1"
PROFILE_PATH=$(awk -F= '/^Path=/{p=$2} /Default=1/{print p; exit}' "$PROFILES_INI")

if [ -z "$PROFILE_PATH" ]; then
    echo "No se encontró perfil default"
    exit 0
fi

TARGET_DIR="$HOME/.zen/$PROFILE_PATH"

mkdir -p "$TARGET_DIR"

# Activa dotglob temporalmente para incluir archivos que empiecen con punto
shopt -s dotglob
cp -rf "{{ .chezmoi.sourceDir }}/.zen/"* "$TARGET_DIR/"
shopt -u dotglob
